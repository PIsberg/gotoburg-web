{
  "name": "gotoburg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "vite preview",
    "admin": "node --env-file=.env.local admin/server.js",
    "test:e2e": "playwright test",
